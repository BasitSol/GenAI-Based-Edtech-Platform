# Credentials are loaded only by explicitly invoked scripts.
OPENAI_API_KEY=
GENERATOR_MODEL=gpt-4.1-mini
GENERATOR_MAX_TOKENS=900
GENERATOR_INPUT_USD_PER_MILLION=0.40
GENERATOR_OUTPUT_USD_PER_MILLION=1.60

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CACHE_BATCH_SIZE=250
EMBEDDING_INPUT_PRICE_PER_MILLION=0.02

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=4
EXTRACTIVE_COMPRESSION_ENABLED=true
ADAPTIVE_MULTI_QUERY_ENABLED=true

INTENT_CLASSIFIER_MODE=adaptive
INTENT_LLM_THRESHOLD=0.68
CLASSIFIER_MODEL=gpt-4.1-mini

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=computer-science-rag-v2

# Phase 2 platform security. Generate a long random value for JWT_SECRET_KEY;
# never commit the populated .env file.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
PLATFORM_DB_PATH=
PLATFORM_API_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Assessment generation includes local reranking plus LLM planning/generation.
# The first request can load model weights, so allow the dashboard to wait.
PLATFORM_REQUEST_TIMEOUT_SECONDS=600
# Strict assessment workflows keep planning deterministic, bound provider
# retries, and reserve enough output for a complete 25-mark paper.
ASSESSMENT_LLM_PLANNER_ENABLED=false
ASSESSMENT_PROVIDER_MAX_ATTEMPTS=3
ASSESSMENT_STRUCTURED_RESPONSE_ATTEMPTS=2
ASSESSMENT_RETRY_BASE_SECONDS=0.75
ASSESSMENT_VALIDATION_RETRIES=2
ASSESSMENT_GENERATOR_MAX_TOKENS=5000
ASSESSMENT_JUDGE_MODEL=gpt-4.1-mini
