OPENAI_API_KEY=
GENERATOR_MODEL=gpt-4.1-mini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_BATCH_SIZE=4
EMBEDDING_CACHE_BATCH_SIZE=16
EMBEDDING_MIN_AVAILABLE_MB=2800
CONTEXTUAL_ENRICHMENT_ENABLED=true
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=4
RERANKER_CANDIDATES=24
RERANKER_CONDITIONAL=false
RERANKER_SCORE_CACHE_SIZE=512
RERANKER_BYPASS_OVERLAP=0.5
RERANKER_MIN_AVAILABLE_MB=1400
LOCAL_MODEL_MEMORY_MODE=sequential
EXTRACTIVE_COMPRESSION_ENABLED=true
CHROMA_PATH=./data_processed/indexes/chroma
METADATA_DB_PATH=./data_processed/databases/metadata.sqlite
LOG_LEVEL=INFO
